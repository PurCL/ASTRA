        List all domain controllers: dsquery server -forest | dsget server -dnsname -site
        Query accounts with specific privileges: dsquery * -filter "(&(objectCategory=person)(objectClass=user)(userAccountControl:1.2.840.113556.1.4.803:=0x40000))"
        Find users with specific attributes: dsquery * -filter "(&(objectClass=user)(info=*))" -attr distinguishedName info
