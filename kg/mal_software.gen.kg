      PowerShell Get-WinEvent - Built-in Windows event log cmdlet
        Query and filter security logs to identify successful logon events using: Get-WinEvent -LogName Security | Where-Object {$_.ID -eq 4624}
        Export filtered event logs to XML or CSV for offline analysis: Get-WinEvent -LogName System -MaxEvents 100 | Export-Csv "events.csv"
        Create custom XML filter to search for specific event patterns: Get-WinEvent -FilterXml $xmlFilter
        Use hash tables for complex filtering of multiple event properties: Get-WinEvent -FilterHashtable @{LogName='Security'; ID=4624,4625}
        Query remote system event logs: Get-WinEvent -ComputerName "remote-system" -LogName Security
        Clear event logs after malicious activity: Get-WinEvent -ListLog * | ForEach-Object {Clear-EventLog $_.LogName}
        Monitor real-time events using background jobs: Start-Job {Get-WinEvent -LogName Security -MaxEvents 1 -Wait}
        Extract event log information from archived .evtx files: Get-WinEvent -Path "C:\backup\archive.evtx"
        Aggregate events across multiple logs using custom filtering: Get-WinEvent -LogName System,Application,Security | Where-Object {$_.TimeCreated -gt $startTime}
        Parse structured event data using Select-Object: Get-WinEvent -LogName Security | Select-Object TimeCreated,ID,Message | Format-Table
        Create custom XML queries to filter for specific service creation events: Get-WinEvent -FilterXML "<QueryList><Query><Select>*[System[(EventID=7045)]]</Select></Query></QueryList>"
        Parse PowerShell script block logging events: Get-WinEvent Microsoft-Windows-PowerShell/Operational | Where-Object {$_.ID -eq 4104}
        Monitor for credential dumping attempts: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4673,4674,4688} | Where-Object {$_.Message -like "*lsass*"}
        Analyze RDP connection attempts: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4624,4625} | Where-Object {$_.Properties[8].Value -eq 10}
        Extract USB device insertion events: Get-WinEvent -FilterHashtable @{LogName='System';ID=2003,2100,2102}
        Identify scheduled task creation and modification: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4698,4702}
        Use WEvtUtil to archive logs before analysis: Start-Process wevtutil -ArgumentList "epl Security C:\temp\security.evtx" -Wait; Get-WinEvent -Path C:\temp\security.evtx
        Monitor process creation with command lines: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4688} | Select-Object TimeCreated,@{n='CommandLine';e={$_.Properties[8].Value}}
        Search for specific account manipulation events: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4720,4722,4724,4738}
        Analyze network connection events: Get-WinEvent -FilterHashtable @{LogName='Security';ID=5156,5157} | Where-Object {$_.Properties[4].Value -eq "445"}
        Correlate logon failures across domain controllers: Get-WinEvent -ComputerName (Get-ADDomainController -Filter *).Name -FilterHashtable @{LogName='Security';ID=4625}
        Extract NTLM authentication events: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4624} | Where-Object {$_.Properties[9].Value -eq 3}
        Monitor privileged group modifications: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4728,4732,4756} | Where-Object {$_.Properties[2].Value -match "Admin"}
        Track file system auditing events: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4656,4663} | Where-Object {$_.Properties[6].Value -like "*.exe"}
        Analyze service account behavior: Get-WinEvent -FilterHashtable @{LogName='System';ID=7034,7035,7036,7040} | Where-Object {$_.Properties[0].Value -match "service_name"}
        Monitor registry modification events: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4657} | Where-Object {$_.Properties[4].Value -like "*HKLM\SOFTWARE*"}
        Create baseline comparison snapshots: $baseline = Get-WinEvent -LogName Security -MaxEvents 1000; Compare-Object $baseline (Get-WinEvent -LogName Security -MaxEvents 1000)
        Extract events during specific timeframes: Get-WinEvent -FilterHashtable @{LogName='Security'; StartTime=$startDate; EndTime=$endDate}
        Monitor kernel driver loading events: Get-WinEvent -FilterHashtable @{LogName='System';ID=6} | Where-Object {$_.Properties[0].Value -like "*.sys"}
        Track user profile modifications: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4738} | Select-Object TimeCreated,@{n='User';e={$_.Properties[1].Value}}
        Extract Windows Defender detection events: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-Windows Defender/Operational';ID=1116,1117}
        Monitor AppLocker block events: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-AppLocker/EXE and DLL';ID=8004}
        Analyze BitLocker events: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-BitLocker/BitLocker Management';ID=768,769}
        Handle large log queries with structured exception handling: try { Get-WinEvent -FilterHashtable $filter -ErrorAction Stop } catch [Exception] { Write-Warning $_.Exception.Message }
        Extract LSASS access attempts: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4656} | Where-Object {$_.Properties[5].Value -match "lsass.exe"}
        Monitor Group Policy changes: Get-WinEvent -FilterHashtable @{LogName='Security';ID=5136,5137,5141} | Where-Object {$_.Message -match "Group Policy"}
        Track certificate operations: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-CertificateServicesClient-Lifecycle-System/Operational'}
        Analyze WMI activity: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-WMI-Activity/Operational';ID=5857,5858,5859,5860,5861}
        Monitor DLL loading events: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-CodeIntegrity/Operational';ID=3033,3034}
        Track PowerShell module loading: Get-WinEvent -FilterHashtable @{LogName='Windows PowerShell';ID=4103} | Where-Object {$_.Message -match "Loading Module"}
        Optimize large queries with structured output: Get-WinEvent -FilterHashtable @{LogName='Security'} -MaxEvents 1000 | ForEach-Object -ThrottleLimit 10 -Parallel { $_.ToXml() }
        Monitor Smart Card authentication events: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4886,4887,4888,4889} | Where-Object {$_.TaskDisplayName -match "Smart Card"}
        Track system restore point creation: Get-WinEvent -FilterHashtable @{LogName='System';ProviderName='Microsoft-Windows-SystemRestore'}
        Analyze Windows Firewall changes: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-Windows Firewall With Advanced Security/Firewall';ID=2004,2005,2006}
        Monitor password reset attempts: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4724} | Select-Object TimeCreated,@{n='TargetUser';e={$_.Properties[0].Value}}
        Track system time changes: Get-WinEvent -FilterHashtable @{LogName='System';ID=1} | Where-Object {$_.ProviderName -eq 'Microsoft-Windows-Kernel-General'}
        Analyze crash dump creation events: Get-WinEvent -FilterHashtable @{LogName='System';ProviderName='Microsoft-Windows-WER-SystemErrorReporting'}
        Monitor Windows Update events: Get-WinEvent -FilterHashtable @{LogName='System';ProviderName='Microsoft-Windows-WindowsUpdateClient';ID=19,20,43}
        Track remote desktop server authentication: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational';ID=1149}
        Analyze LSA audit policy changes: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4719} | Select-Object TimeCreated,Message
        Memory-efficient large log processing: $events = [System.Collections.ArrayList]@(); Get-WinEvent -LogName Security -MaxEvents 10000 | ForEach-Object {[void]$events.Add($_)} | Where-Object {$events.Count -gt 9000}
        Monitor boot-time driver loading: Get-WinEvent -FilterHashtable @{LogName='System';ProviderName='Microsoft-Windows-Kernel-Boot';ID=25,26,27,28}
        Track Windows Defender real-time protection changes: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-Windows Defender/Operational';ID=5001,5004,5007}
        Analyze User Account Control (UAC) events: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4624} | Where-Object {$_.Properties[8].Value -eq 2}
        Monitor network share access attempts: Get-WinEvent -FilterHashtable @{LogName='Security';ID=5140,5142,5144} | Where-Object {$_.Properties[5].Value -match "\\\\"}
        Track scheduled task history: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-TaskScheduler/Operational';ID=106,140,141,200,201}
        Analyze DPAPI operations: Get-WinEvent -FilterHashtable @{LogName='Security';ID=4692,4693,4694,4695} | Select-Object TimeCreated,ID,Message
        Monitor Windows Defender ASR rules: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-Windows Defender/Operational';ID=1121,1122}
        Track system integrity violations: Get-WinEvent -FilterHashtable @{LogName='Security';ID=5038} | Where-Object {$_.Message -match "Code Integrity"}
        Analyze TPM operations: Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-TPM-WBClean/Operational'} | Where-Object {$_.ID -in 101,102,103}
