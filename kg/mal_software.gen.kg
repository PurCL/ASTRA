        Enumerate nested group memberships: dsquery group -name "*admin*" | dsget group -members -expand
        Find recently created accounts: dsquery * -filter "(&(objectClass=user)(whenCreated>=20230101000000.0Z))" -attr sAMAccountName whenCreated
        Query for accounts with specific SID history: dsquery * -filter "(&(objectClass=user)(sIDHistory=*))" -attr sAMAccountName sIDHistory
        Discover accounts with specific service principal names: dsquery * -filter "(&(objectClass=user)(servicePrincipalName=*))" -attr sAMAccountName servicePrincipalName
        Find accounts with administrative comments: dsquery * -filter "(&(objectClass=user)(comment=*))" -attr sAMAccountName comment
        Locate accounts in specific OUs: dsquery user "OU=IT,DC=domain,DC=com" -limit 0 | dsget user -samid -memberof
        Query deleted objects in AD recycle bin: dsquery * -filter "(&(objectClass=*)(isDeleted=TRUE))" -attr whenChanged lastKnownParent
        Find accounts with specific login hours restrictions: dsquery * -filter "(&(objectClass=user)(logonHours=*))" -attr sAMAccountName logonHours
        Enumerate user accounts with specific security descriptors: dsquery * -filter "(&(objectClass=user)(nTSecurityDescriptor=*))" -attr sAMAccountName nTSecurityDescriptor
        Search for accounts with specific home directory mappings: dsquery * -filter "(&(objectClass=user)(homeDirectory=*))" -attr sAMAccountName homeDirectory
        Identify accounts with specific profile paths: dsquery * -filter "(&(objectClass=user)(profilePath=*))" -attr sAMAccountName profilePath
        Find accounts with specific terminal service settings: dsquery * -filter "(&(objectClass=user)(terminalServer=*))" -attr sAMAccountName userParameters
        Query for accounts with specific password policies: dsquery * -filter "(&(objectClass=user)(pwdLastSet=*))" -attr sAMAccountName pwdLastSet accountExpires
        Discover accounts with specific connection objects: dsquery * -filter "(&(objectClass=user)(connectionPoint=*))" -attr sAMAccountName
        Search for accounts with specific certificate templates: dsquery * -filter "(&(objectClass=user)(userCertificate=*))" -attr sAMAccountName userCertificate
        Find accounts with specific proxy addresses: dsquery * -filter "(&(objectClass=user)(proxyAddresses=*))" -attr sAMAccountName proxyAddresses
        Export comprehensive user account report: dsquery * -filter "(&(objectClass=user)(objectCategory=person))" -attr * -limit 0 > user_report.txt
        Query accounts modified by specific admin: dsquery * -filter "(&(objectClass=user)(modifiedBy=*))" -attr sAMAccountName whenChanged modifiedBy
        Find accounts with specific login workstation restrictions: dsquery * -filter "(&(objectClass=user)(userWorkstations=*))" -attr sAMAccountName userWorkstations
        Search for accounts with specific primary group assignments: dsquery * -filter "(&(objectClass=user)(!(primaryGroupID=513)))" -attr sAMAccountName primaryGroupID
        Query for accounts with specific manager attributes: dsquery * -filter "(&(objectClass=user)(manager=*))" -attr sAMAccountName manager
        Find accounts with specific department assignments: dsquery * -filter "(&(objectClass=user)(department=*))" -attr sAMAccountName department title
